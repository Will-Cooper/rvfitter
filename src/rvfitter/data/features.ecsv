# %ECSV 1.0
# ---
# datatype:
# - {name: name, datatype: string}
# - {name: species, datatype: string}
# - {name: kind, datatype: string}
# - {name: wave_vac, unit: Angstrom, datatype: float64}
# - {name: wmin, unit: Angstrom, datatype: float64}
# - {name: wmax, unit: Angstrom, datatype: float64}
# - {name: teff_min, unit: K, datatype: float64}
# - {name: teff_max, unit: K, datatype: float64}
# - {name: r_min, datatype: float64}
# - {name: rest_ref, datatype: string}
# - {name: caveat, datatype: string}
# - {name: depth, datatype: float64}
# - {name: model_fidelity, datatype: string}
# meta: !!omap
# - {description: 'rvfitter feature catalogue; vacuum wavelengths; NaN = not applicable; depth = approximate telluric absorption depth
#     (R~2000, airmass 1); model_fidelity = how well synthetic grids (BT-Settl, Sonora) reproduce the feature for late-M/L/T dwarfs: good
#     (atomic lines with laboratory wavelengths; CO overtone bandheads), poor (TiO, VO, CrH, FeH, H2O, CH4 bands, whose incomplete or
#     inaccurate molecular opacities shift fitted RVs: deep-research-report.md, "Synthetic versus empirical templates" and the "Synthetic-template
#     mismatch" row of the systematics table; Hsu et al. 2021), n/a (telluric)'}
# schema: astropy-2.0
name species kind wave_vac wmin wmax teff_min teff_max r_min rest_ref caveat depth model_fidelity
